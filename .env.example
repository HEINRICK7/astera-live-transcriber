ASTERA_TRANSCRIBER_ENV=development

ASTERA_TRANSCRIBER_HOST=0.0.0.0
ASTERA_TRANSCRIBER_PORT=8000

ASTERA_TRANSCRIBER_LOG_LEVEL=INFO

ASTERA_TRANSCRIBER_API_KEY=change-me

ASTERA_TRANSCRIBER_DEFAULT_MODEL=astera-stt-1
ASTERA_TRANSCRIBER_DEFAULT_LANGUAGE=pt-BR

ASTERA_TRANSCRIBER_AUDIO_MAX_SECONDS=3600
ASTERA_TRANSCRIBER_AUDIO_RETENTION=false

ASTERA_TRANSCRIBER_AUDIO_SAMPLE_RATE=16000
ASTERA_TRANSCRIBER_AUDIO_CHUNK_MS=100
ASTERA_TRANSCRIBER_VAD_ENABLED=true
ASTERA_TRANSCRIBER_VAD_THRESHOLD=0.5
ASTERA_TRANSCRIBER_PREFIX_PADDING_MS=300
ASTERA_TRANSCRIBER_MIN_SPEECH_MS=200
ASTERA_TRANSCRIBER_SILENCE_CANDIDATE_MS=500
ASTERA_TRANSCRIBER_COMMIT_SILENCE_MS=1500
ASTERA_TRANSCRIBER_MAX_SILENCE_MS=3000
ASTERA_TRANSCRIBER_MAX_SEGMENT_DURATION_MS=30000
ASTERA_TRANSCRIBER_RING_BUFFER_MAX_DURATION_MS=60000
ASTERA_TRANSCRIBER_RING_BUFFER_MAX_CHUNKS=500

# Safe by default. Set to parakeet only after downloading the model locally.
ASTERA_TRANSCRIBER_ENGINE=noop
ASTERA_TRANSCRIBER_INSTALL_PARAKEET=false
ASTERA_TRANSCRIBER_ENGINE_PROVIDER=cpu
ASTERA_TRANSCRIBER_MODEL_PATH=/models/parakeet-tdt-0.6b-v3-int8
ASTERA_TRANSCRIBER_ENGINE_THREADS=4
ASTERA_TRANSCRIBER_ENGINE_DEBUG=false
ASTERA_TRANSCRIBER_ENGINE_WARMUP=true
ASTERA_TRANSCRIBER_PARTIAL_INTERVAL_MS=1000
ASTERA_TRANSCRIBER_MAX_CONCURRENT_INFERENCES=1
ASTERA_TRANSCRIBER_FILE_EVENT_QUEUE_SIZE=100
ASTERA_TRANSCRIBER_FILE_TEMP_DIR=/tmp/astera-live-transcriber
ASTERA_TRANSCRIBER_FILE_CANCEL_ON_DISCONNECT=true
ASTERA_TRANSCRIBER_FILE_ATTACH_TIMEOUT_SECONDS=300
